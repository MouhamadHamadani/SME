<?xml version="1.0" encoding="UTF-8"?>
<!--
    The same suite, against real MySQL.

        php artisan db:create-test-database   (or create sme_test_central by hand)
        ./vendor/bin/pest -c phpunit.mysql.xml

    Why this exists: the default suite runs on SQLite, and SQLite forgives
    things MySQL does not — date comparison, strict mode, collation, storage
    engine. Two real defects in this codebase were exactly that divergence: a
    VAT quarter whose last day was silently dropped, and an EOSI accrual that
    inserted a duplicate on SQLite where MySQL would have matched. Running only
    on SQLite means production is the first place the difference is noticed.

    Tenant databases are created and dropped for real here, so this run is much
    slower than the SQLite one. It is a pre-release gate, not the inner loop.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_URL" value="http://sme.test" force="true"/>
        <env name="CENTRAL_DOMAINS" value="127.0.0.1,localhost,sme.test" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>

        <!-- The difference from phpunit.xml. -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_DATABASE" value="sme_test_central" force="true"/>
        <env name="DB_USERNAME" value="root" force="true"/>
        <env name="DB_PASSWORD" value="" force="true"/>
        <!-- WAMP defaults to MyISAM, which has no transactions. -->
        <env name="DB_ENGINE" value="InnoDB" force="true"/>
        <env name="DB_URL" value="" force="true"/>

        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
